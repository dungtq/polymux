# Settings for the pm edge stack. Copy to .env (cp env.example .env) and edit.
# .env stays out of git. All values below are examples; replace them with your own.

## Host names ---------------------------------------------------------------

# Public names of pm and ntfy. Both must resolve to this server (DNS or /etc/hosts)
# and must be covered by CERT_DOMAINS below.
PM_HOST=pm.example.lan
NTFY_HOST=ntfy.example.lan

# Port pm listens on (on the host, see binds in ~/.config/pm/pm.toml).
PM_PORT=8093

## Certificates (cert-manager) ---------------------------------------------

# Comma-separated DNS names for the leaf certificate. A wildcard covers both hosts above.
CERT_DOMAINS=*.example.lan,example.lan
# Comma-separated IP addresses for the leaf (add the server's address to open sites by IP).
CERT_IPS=127.0.0.1

# generate = create a private root CA on first start; import = use ca.crt + ca.key you
# put in data/pki/ca/ before the first start.
CA_MODE=generate
CA_COMMON_NAME=pm stack private root CA
CA_DAYS=3650
# rsa4096 or ec384
CA_KEY_ALGO=rsa4096

# Leaf lifetime (max 397 days), renewal window and how often to check.
CERT_LEAF_DAYS=397
CERT_RENEW_BEFORE_DAYS=30
CERT_CHECK_INTERVAL=12h

# Optional Pushover messages on renewal and failure. Leave empty to turn them off.
PUSHOVER_TOKEN=
PUSHOVER_USER=

## nginx-ui ------------------------------------------------------------------

# Container name; cert-manager restarts it after a renewal.
NGINX_UI_CONTAINER=pm-nginx-ui
HTTP_PORT=80
HTTPS_PORT=443
# Admin panel. Loopback by default; use an SSH tunnel to reach it from another machine.
NGINX_UI_PANEL_BIND=127.0.0.1
NGINX_UI_HTTP_PORT=9000

## Misc ----------------------------------------------------------------------

TZ=UTC
