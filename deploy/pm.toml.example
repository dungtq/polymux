# pm config: copy to ~/.config/pm/pm.toml (mode 0600). Every key is optional; docs/CONFIG.md lists them all.

# systemd's PATH may lack your tmux (mise, asdf, a custom build). Pin the binary that matches the
# running tmux server: a different version cannot talk to it (empty session list).
# tmux_bin = "/usr/bin/tmux"

# Public URL behind your TLS reverse proxy; allowed_origins defaults to [base_url].
# base_url = "https://pm.example.lan"
# binds = ["127.0.0.1"]            # add the docker bridge gateway (e.g. "172.17.0.1") when nginx runs in a container; never 0.0.0.0
# port = 8093

# dev_root = "~/dev"                # every git repo directly under it is a project
# extra_projects = ["~/notes"]

# ntfy: pm's own alerts (ntfy_url, ntfy_pm_topic_url) and the agent topic mirrored in the Inbox. "" = off.
# ntfy_url = "https://ntfy.example.lan/pm"
# ntfy_pm_topic_url = "https://ntfy.example.lan/pm"
# ntfy_topic_url = "https://ntfy.example.lan/agent"

# git remotes panel: hosts a project's remote may point at; commit hashes link to https://<host>/<owner>/<repo>/commit/
# git_allowed_hosts = ["git.example.lan"]

# extra hosts on the Servers page (TCP check)
# servers = [{ name = "nas", host = "192.168.1.10", port = 22, note = "backups" }]

# display_utc_offset_h = 0          # GUI timestamps use this fixed UTC offset
# vm_protected = ["*prod*"]         # libvirt VMs (fnmatch globs) pm never changes
# actor_cmd = ["tmux-agents", "id"] # prints the agent id pmctl records when $PM_ACTOR is unset; [] = "agent"

# tier_ceiling = 2
# unprotected_sessions = []
# autoexit_sessions = ["*"]         # tmux sessions where idle agents may be auto-exited (pm* never)
# autoexit_idle_s = 86400           # exit Claude agents idle this long (0 = off)
# autoexit_close_window = false     # also close the window after an auto-exit (default: it stays)
# past_sessions_interval_s = 600    # import past CLI sessions of each project folder (0 = off, min 60)
# idle_after_s = 28800              # inbox: finished -> idle after this many seconds

# UI theme: "classic" (built in) or "dt" (ships with pm, docs/themes/dt/); plugins (entry-point group
# "pm.plugins") may add more. Each browser can still pick its own in Settings or with ?ui=dt.
# theme = "classic"
# plugins_enabled = true            # false loads no plugin; env PM_NO_PLUGINS=1 skips installed ones
# [plugins.example]                 # one table per plugin, handed to that plugin only
# refresh_s = 60
