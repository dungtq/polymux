[Unit]
Description=pm control plane (127.0.0.1:8093, behind nginx)
After=network.target

[Service]
Type=simple
# Path of your clone (docs/INSTALL.md step 7); change both lines if it is not ~/polymux.
WorkingDirectory=%h/polymux
ExecStart=%h/polymux/.venv/bin/pm
Restart=on-failure
TimeoutStopSec=15
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target
