# ---- coordination (pmctl) ---------------------------------------------------
def pmctl_path() -> str:
    exe = os.environ.get("TA_PMCTL") or "pmctl"
    path = exe if os.sep in exe else shutil.which(exe)
    if not path or not os.access(path, os.X_OK):
        die(f"pmctl not found ({exe}): claims live in pm.db and need pm's pmctl on this host "
            "(TA_PMCTL overrides the path)", 2)
    return path


def unknown_cmd(rc: int, err: str, sub: str):
    if rc != 0 and "invalid choice" in err and f"'{sub}'" in err:  # argparse (pmctl exits 1 or 2)
        die(f"this pmctl has no `{sub}` command yet (update pm / polymux)", 2)


def pmctl(args: list[str], ok_codes=(0,)) -> tuple[int, dict]:
    """pmctl --json ARGS -> (exit code, parsed JSON); exit 2 with a clear message on any trouble."""
    argv = [pmctl_path(), "--json", *args]
    sub = next((a for a in args if a in ("claim", "merge-check")), args[0])
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        die(f"pmctl {sub} timed out", 2)
    except OSError as e:
        die(f"pmctl: {e.strerror}", 2)
    err = p.stderr.strip()
    unknown_cmd(p.returncode, err, sub)
    if p.returncode not in ok_codes:
        die(f"pmctl {sub} failed (exit {p.returncode}): {err or p.stdout.strip()}", 2)
    try:
        data = json.loads(p.stdout)
    except ValueError:
        die(f"pmctl {sub}: no JSON output: {p.stdout.strip()[:200]}", 2)
    if not isinstance(data, dict):
        die(f"pmctl {sub}: unexpected JSON", 2)
    return p.returncode, data


def split_project(args: list[str]) -> tuple[list[str], list[str]]:
    """Pull `--project P` out of args (forwarded as pmctl's global option)."""
    if "--project" in args:
        i = args.index("--project")
        return ["--project", take(args, i, "--project")], args[:i] + args[i + 2:]
    return [], args


def paths_of(c: dict) -> str:
    return ", ".join(c.get("paths") or []) or "whole repo"


def claim_line(c: dict) -> str:
    pane = f" pane {c['pane']}" if c.get("pane") else ""
    stale = " [stale]" if c.get("stale") else ""
    return f"c{c.get('num')} {c.get('agent')} '{c.get('title')}' on {c.get('branch')} ({paths_of(c)}){pane}{stale}"


def notify_claims(claims: list[dict], text_for) -> None:
    """--no-reply FYI to the pane of each overlapping claim (one message per pane)."""
    ag = Agents()
    targets, texts = [], {}
    for c in claims:
        pane = c.get("pane") or ""
        if not pane or pane == own_pane():
            continue
        p = next((q for q in ag.panes if q["pane_id"] == pane and not q["dead"]), None)
        if p is None:
            print(f"  c{c.get('num')}: pane {pane} is gone; not notified")
            continue
        if pane not in texts:
            targets.append(p)
            texts[pane] = []
        texts[pane].append(text_for(c))
    for p, mid, st in send_many(targets, {k: "\n".join(v) for k, v in texts.items()}):
        print(f"  notified {p['@agent_name'] or p['pane_id']} ({p['pane_id']}): {mid or '-'} {st}")


def my_handle(claim: dict) -> str:
    """How others address us: pm id (also tagged on our own pane), else name, else pane."""
    pmid = self_id() or claim.get("agent") or ""
    if pmid == "agent":
        pmid = ""
    tag_self(pmid)
    return pmid or own_name() or own_pane() or "?"


def cmd_claim(args):
    proj, args = split_project(args)
    if not args or args[0].startswith("-"):
        die('claim "title" [--path GLOB ...] [--issue N]')
    opts, rest = parse_opts(args[1:], set(), {"--path", "--issue", "--branch", "--worktree"})
    if rest:
        die(f"unexpected argument: {rest[0]}")
    pm_args = [*proj, "claim", "add", args[0]]
    for g in opts.get("--path", []):
        pm_args += ["--path", g]
    for k in ("--issue", "--branch", "--worktree"):
        if k in opts:
            pm_args += [k, one(opts, k)]
    _, res = pmctl(pm_args)
    c = res.get("claim") or {}
    overlaps = res.get("overlaps") or []
    print(f"c{c.get('num')}")
    me = my_handle(c)
    for o in overlaps:
        print(f"overlap: {claim_line(o)}")
    notify_claims(overlaps, lambda o: (
        f"agent {me} claimed c{c.get('num')} '{c.get('title')}' on {c.get('branch')}, overlapping your "
        f"c{o.get('num')} ({paths_of(o)}); coordinate via tmux-agents send {me}"))


def cmd_done(args):
    proj, args = split_project(args)
    if not args:
        die("done N [--commit SHA] [--note TEXT]")
    n = args[0].lstrip("c")
    opts, rest = parse_opts(args[1:], set(), {"--commit", "--note"})
    if rest:
        die(f"unexpected argument: {rest[0]}")
    pm_args = [*proj, "claim", "done", n]
    for k in ("--commit", "--note"):
        if k in opts:
            pm_args += [k, one(opts, k)]
    _, res = pmctl(pm_args)
    c = res.get("claim") or {}
    overlaps = res.get("overlaps") or []
    sha = c.get("commit") or one(opts, "--commit") or ""
    print(f"c{c.get('num', n)} done" + (f" in {sha}" if sha else ""))
    me = my_handle(c)
    for o in overlaps:
        print(f"overlap: {claim_line(o)}")
    notify_claims(overlaps, lambda o: (
        f"agent {me} finished c{c.get('num', n)} '{c.get('title')}' in {sha or '(no commit given)'}, "
        f"overlapping your c{o.get('num')} ({paths_of(o)}); rebase before merging"))


def cmd_merge_check(args):
    proj, args = split_project(args)
    opts, rest = parse_opts(args, set(), {"--base"})
    if rest:
        die(f"unexpected argument: {rest[0]}", 2)
    pm_args = [*proj, "merge-check"] + (["--base", one(opts, "--base")] if "--base" in opts else [])
    rc, r = pmctl(pm_args, ok_codes=(0, 1))
    files = r.get("files") or []
    print(f"{r.get('branch')} -> {r.get('base')}: {len(files)} file(s) changed")
    if r.get("base_moved"):
        print(f"warning: {r.get('base')} has {r.get('behind')} commit(s) not in this branch; "
              f"rebase/merge {r.get('base')} first")
    claims = r.get("claims") or []
    if claims:
        print("overlapping claims of other agents:")
        for c in claims:
            print(f"  {claim_line(c)}")
    wts = r.get("worktrees") or []
    if wts:
        print("other work trees touching these files:")
        for w in wts:
            print(f"  {w.get('path')} ({w.get('branch')}): {', '.join(w.get('files') or [])}")
    if rc == 0:
        print("clear: no overlapping claims or work trees")
        return
    print("OVERLAP: message the claim owners (tmux-agents send <agent>) or ask the user; "
          "do not merge over it unasked")
    raise Fail("", rc)


def cmd_board(args):
    proj, args = split_project(args)
    js = ["--json"] if "--json" in args else []
    argv = [pmctl_path(), *js, *proj, "claim", "list", *[a for a in args if a != "--json"]]
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        die(f"pmctl claim list: {e}", 2)
    unknown_cmd(p.returncode, p.stderr, "claim")
    sys.stdout.write(p.stdout)
    sys.stderr.write(p.stderr)
    if p.returncode:
        raise Fail("", p.returncode)


COMMANDS = {
    "spawn": cmd_spawn, "send": cmd_send, "reply": cmd_reply, "inbox": cmd_inbox, "broadcast": cmd_broadcast,
    "wait": cmd_wait, "result": cmd_result, "read": cmd_read, "idle": cmd_idle, "run": cmd_run, "log": cmd_log,
    "ls": cmd_ls, "kill": cmd_kill, "whoami": cmd_whoami, "id": cmd_id, "claim": cmd_claim, "done": cmd_done,
    "merge-check": cmd_merge_check, "board": cmd_board, "_deliver": cmd_deliver,
}
HINT_CMDS = {"send", "reply", "broadcast", "claim", "done", "merge-check", "board", "ls", "wait"}


def main(argv: list[str]) -> int:
    c = argv[0] if argv else ""
    if c in ("", "-h", "--help", "help"):
        sys.stdout.write(USAGE)
        return 0
    try:
        fn = COMMANDS.get(c)
        if fn is None:
            sys.stdout.write(USAGE)
            die(f"unknown command: {c}")
        fn(argv[1:])
        if c in HINT_CMDS:
            inbox_hint()
        return 0
    except Fail as e:
        if str(e):
            warn(str(e))
        return e.code
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
