        die("idle TARGET [--quiet SEC] [--timeout SEC]")
    opts, _ = parse_opts(args[1:], set(), {"--quiet", "--timeout"})
    p = resolve(args[0])
    st = wait_quiet(p["pane_id"], num(one(opts, "--quiet", "3"), "--quiet"),
                    num(one(opts, "--timeout", "300"), "--timeout"))
    if st == "busy":
        raise Fail("", 124)
    if st == "dead":
        die(f"pane {p['pane_id']} is dead")


def cmd_run(args):
    if not args or "--" not in args[1:]:
        die("run NAME [spawn opts] -- PROMPT")
    name, rest = args[0], args[1:]
    k = rest.index("--")
    prompt = " ".join(rest[k + 1:])
    if not prompt:
        die("run NAME [spawn opts] -- PROMPT")
    pane, _ = spawn(name, ["--mode", "quick", *rest[:k]])
    p = pane_info(pane)
    if p is None or p["dead"]:
        die(f"pane {pane} for '{name}' is dead")
    mid, _ = send(p, prompt, "request")
    cmd_wait([mid, "--timeout", str(env_f("TA_RUN_TIMEOUT", 900))])


